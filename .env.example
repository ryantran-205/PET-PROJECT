# Copy to `.env` (never commit `.env`). All values below are PLACEHOLDERS — generate your own.
# Generate random secrets e.g.:  openssl rand -base64 48   |  PowerShell: [Convert]::ToBase64String((1..48|%{Get-Random -Max 256}))

ASPNETCORE_ENVIRONMENT=Development

# ---- SQL Server (container) ----
SQL_SA_PASSWORD=<change-me-Strong!Passw0rd>
SQL_DATABASE=Fnb
SQL_PORT=14333

# ---- Redis ----
REDIS_PORT=6379

# ---- Message broker: RabbitMQ locally, Azure Service Bus in cloud (Messaging__Provider=AzureServiceBus) ----
RABBITMQ_USER=fnb
RABBITMQ_PASSWORD=<change-me>
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# ---- Auth / tokens (>= 32 bytes each) ----
JWT_ISSUER=fnb-api
JWT_AUDIENCE=fnb-clients
JWT_SIGNING_KEY=<generate-a-random-32+-byte-secret>
TRACKING_TOKEN_SECRET=<generate-a-random-32+-char-secret>

# ---- URLs / CORS ----
PUBLIC_BASE_URL=http://localhost:8080
API_PORT=5080
WEB_PORT=8080
# Frontend build-time API base. Empty = same origin (nginx/Vite proxy). Example for split hosting: https://api.example.com
VITE_API_BASE_URL=

# ---- Development seed (demo users share this password). Leave empty to skip seeding. NEVER set in production. ----
SEED_DEV_PASSWORD=

# ---- Telemetry (optional) ----
APPLICATIONINSIGHTS_CONNECTION_STRING=
