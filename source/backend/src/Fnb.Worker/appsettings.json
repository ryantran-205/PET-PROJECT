{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "Sql": "",
    "Redis": ""
  },
  "Ordering": {
    "TrackingTokenSecret": "",
    "PublicBaseUrl": "http://localhost:5173"
  },
  "Messaging": {
    "Provider": "RabbitMQ",
    "MaxDeliveryAttempts": 5,
    "RabbitMq": { "ConnectionString": "", "ExchangePrefix": "fnb" },
    "AzureServiceBus": { "ConnectionString": "", "FullyQualifiedNamespace": "" }
  },
  "Outbox": {
    "PollIntervalMs": 1000,
    "BatchSize": 50,
    "MaxAttempts": 10
  },
  "Retention": {
    "PublishedOutboxDays": 7,
    "ProcessedMessageDays": 14,
    "AuditLogDays": 365,
    "RevokedRefreshTokenDays": 30
  }
}
