{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Sql": "",
    "Redis": ""
  },
  "Jwt": {
    "Issuer": "fnb-api",
    "Audience": "fnb-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Security": {
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "MinPasswordLength": 8
  },
  "Ordering": {
    "TrackingTokenSecret": "",
    "PublicBaseUrl": "http://localhost:5173",
    "MaxLinesPerOrder": 30,
    "MaxQuantityPerLine": 50,
    "AllowCustomerCancel": true,
    "IdempotencyHours": 24
  },
  "Attendance": {
    "RoundingIncrementMinutes": 15,
    "RoundingMode": "Floor",
    "MaxShiftHours": 16
  },
  "Reports": {
    "MaxRangeDays": 366,
    "MaxExportRows": 100000
  },
  "Cache": {
    "PublicMenuSeconds": 300
  },
  "Messaging": {
    "Provider": "RabbitMQ",
    "MaxDeliveryAttempts": 5,
    "RabbitMq": { "ConnectionString": "", "ExchangePrefix": "fnb" },
    "AzureServiceBus": { "ConnectionString": "", "FullyQualifiedNamespace": "" }
  },
  "Outbox": {
    "PollIntervalMs": 1000,
    "BatchSize": 50,
    "MaxAttempts": 10
  },
  "Hosting": {
    "EnableInProcessWorker": false
  },
  "RateLimiting": {
    "LoginPerMinute": 10,
    "PublicOrderPerMinute": 20,
    "PublicReadPerMinute": 240
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Azure": {
    "SignalR": { "ConnectionString": "" }
  }
}
